# Optional: Set full API URL if backend is on a separate subdomain (e.g. api.yourdomain.com)
# If left blank, it defaults to '/api' which proxies through the same domain
VITE_API_URL=https://api.yourdomain.com/api

# Optional: Set Socket.IO endpoint if backend is on a separate subdomain
# If left blank, it connects to the same domain host
VITE_SOCKET_URL=https://api.yourdomain.com

